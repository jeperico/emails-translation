<p>Olá, <%= @resource.name %>,</p>

<% account_user = @resource&.account_users&.first %>

<% if account_user&.inviter.present? && @resource.unconfirmed_email.blank? %>
  <p><%= account_user.inviter.name %>, da equipe <%= account_user.account.name %>, convidou você para experimentar o <%= global_config['BRAND_NAME'] || 'Chatwoot' %>.</p>
<% end %>

<% if @resource.confirmed? %>
  <p>Você pode acessar sua conta do <%= global_config['BRAND_NAME'] || 'Chatwoot' %> através do link abaixo:</p>
<% else %>
  <% if account_user&.inviter.blank? %>
  <p>
    Bem-vindo(a) ao <%= global_config['BRAND_NAME'] || 'Chatwoot' %>! Temos um conjunto de ferramentas poderosas prontas para você explorar. Mas antes, precisamos verificar seu endereço de e-mail para garantir que é realmente você.
  </p>
  <% end %>
  <p>Por favor, clique no link abaixo para ativar sua conta.</p>
<% end %>

<% if @resource.unconfirmed_email.present? %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% elsif @resource.confirmed? %>
  <p><%= link_to 'Acessar minha conta', frontend_url('auth/sign_in') %></p>
<% elsif account_user&.inviter.present? %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/password/edit', reset_password_token: @resource.send(:set_reset_password_token)) %></p>
<% else %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% end %>
<p>Se você não solicitou essa confirmação, pode ignorar este e-mail.</p>
